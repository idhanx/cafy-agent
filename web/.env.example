# ── Cafy Agent — hosted (Vercel) environment ─────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.

# REQUIRED ─ the shared password the client types to sign in.
CAFY_APP_PASSWORD=change-me-to-something-long

# REQUIRED ─ a long random string (e.g. `openssl rand -base64 32`). Signs the sign-in
# cookie and encrypts any AI key saved from Settings.
AUTH_SECRET=

# REQUIRED ─ added automatically when you connect a PRIVATE Vercel Blob store to the
# project (Storage → Create → Blob → Private). Holds the client's CV, tracker, reports.
BLOB_READ_WRITE_TOKEN=

# AI provider ─ pick ONE:
#  (a) leave unset and let the client paste their OpenRouter key in Settings → AI provider, or
#  (b) set it here so the AI features work from the first sign-in.
OPENROUTER_API_KEY=
# Optional model override (default: anthropic/claude-sonnet-4.5)
CAFY_AI_MODEL=

# OPTIONAL ─ Upstash Redis / Vercel KV. Lets several server instances notice each other's
# changes instantly. Without it, changes are picked up within ~10 seconds.
KV_REST_API_URL=
KV_REST_API_TOKEN=
